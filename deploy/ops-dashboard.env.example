# Example environment file for JamBetter unified ops dashboard
# Copy to /etc/jambetter/ops-dashboard.env (or your preferred path) and edit.

# Port to bind on localhost (recommend using an external reverse proxy for TLS)
OPS_DASHBOARD_PORT=5090

# Optional shared token (if empty/unset, dashboard is open)
OPS_DASHBOARD_TOKEN=

# Server inventory for the fleet view
OPS_SERVERS_FILE=/etc/jambetter/ops_servers.json

# Pins storage: local file-backed JSON
OPS_PINS_FILE=/var/lib/jambetter/ops-pins.json

# Optional: remote pins backend (Cloudflare Worker + D1)
# OPS_PINS_REMOTE_URL=https://<your-worker-host>
# OPS_PINS_REMOTE_TOKEN=

# Health check output path (healthcheck.py writes here)
JAMBETTER_HEALTH_JSON=/var/lib/jambetter/health.json

# Health check script path (optional)
# JAMBETTER_HEALTH_SCRIPT=/home/nds/jambetterbase/healthcheck.py

# Fleet poll cache in seconds (reduce fanout if many operators open the page)
OPS_FLEET_CACHE_S=5

# Audit log for proxied start/stop/restart calls
OPS_AUDIT_FILE=/var/log/jambetter/ops-audit.jsonl
